VITE_CONTRACT_ADDRESS=0x45d027236c164c4740474cCE553aFd8d73E2b41b
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=
VITE_PINATA_JWT=
VITE_AVALANCHE_RPC=https://api.avax-test.network/ext/bc/C/rpc
VITE_CHAIN_ID=43113
VITE_CHAIN_NAME=Avalanche Fuji Testnet
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Optional comma-separated extra download gateways. Pinata, Infura, Cloudflare, and ipfs.io are already in the pool.
# VITE_IPFS_FALLBACK_GATEWAYS=
# Optional per-gateway download timeout in milliseconds (default 8000)
# VITE_IPFS_GATEWAY_TIMEOUT_MS=8000
VITE_CONTRACT_DEPLOY_BLOCK=52127503
VITE_TX_WAIT_TIMEOUT_MS=180000
VITE_TELEMETRY_WEBHOOK=
# Optional: Set to point frontend IPFS uploads at the serverless proxy instead of Pinata directly
# Prevents Pinata API key exposure in the client bundle
VITE_IPFS_PROXY_URL=
# HMAC secret used to sign proxy requests (must match SPOOVUALT_PROXY_SECRET on the proxy)
VITE_SPOOVUALT_PROXY_SECRET=
# Proxy-only (do not expose Pinata JWT to the browser)
# SPOOVUALT_PROXY_SECRET=
# SPOOVUALT_ALLOWED_ORIGINS=http://localhost:5173,https://app.spoovault.io
# Required only to run: node scripts/deploy.mjs
# Use a throwaway wallet with testnet AVAX only - never commit this key
DEPLOYER_PRIVATE_KEY=

# Optional: Soroban contract address for the Stellar network (Freighter connection)
VITE_STELLAR_CONTRACT_ADDRESS=

# Optional: Soroban identity_registry contract address. When set, the
# dual-signed cross-chain identity binding (issue #131) is recorded on-chain
# and resolveEvmToStellar/resolveStellarToEvm query the registry.
VITE_IDENTITY_REGISTRY_ADDRESS=

# Private Information Retrieval (PIR) Configuration
# Enable PIR to obscure which documents are being fetched from IPFS gateways
VITE_PIR_ENABLED=false
# Use Tor SOCKS5 proxy for IPFS fetches (requires local Tor daemon)
VITE_PIR_USE_TOR=false
# Tor SOCKS5 proxy host (default: 127.0.0.1)
VITE_PIR_TOR_HOST=127.0.0.1
# Tor SOCKS5 proxy port (default: 9050)
VITE_PIR_TOR_PORT=9050
# Number of dummy queries to batch with real queries (default: 5)
VITE_PIR_DUMMY_COUNT=5
# Delay between dummy queries in milliseconds (default: 100)
VITE_PIR_BATCH_DELAY=100

# Soroban Event Indexer Configuration
# WebSocket relay URL for real-time Soroban event broadcasting
# If set, the frontend will connect to this WebSocket gateway for live event updates
# Format: ws://localhost:8080 or wss://your-gateway.com
VITE_SOROBAN_EVENT_RELAY_URL=

